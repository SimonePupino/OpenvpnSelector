client
dev tun
proto udp
remote 
verify-x509-name 

nobind
auth-user-pass config/credentials

resolv-retry infinite

cipher 
ncp-ciphers 
auth 

verb 2
mute-replay-warnings
remote-cert-tls server
persist-key
persist-tun

key-direction 1
<ca>
-----BEGIN CERTIFICATE-----
aaaaaaaaaaaaaaaa
-----END CERTIFICATE-----
</ca>
<tls-auth>
-----BEGIN OpenVPN Static key V1-----
aaaaaaaaaaaaaaaa
-----END OpenVPN Static key V1-----
</tls-auth>
